# Keep credentials in .env (ignored), or export them in the shell.
# Use your existing key; never paste it into source code.
GOOGLE_API_KEY=
# To use OpenAI: CHEF_MODEL=openai/gpt-4o (or pass --model openai/gpt-4o).
OPENAI_API_KEY=
# GEMINI_API_KEY is also accepted. The demo selects the Gemini Developer API.
# GOOGLE_GENAI_USE_VERTEXAI is set to false by the terminal configuration.
CHEF_MODEL=gemini-2.5-flash
CHEF_MAX_MODEL_CALLS=40
CHEF_MAX_TOOL_CALLS=80
CHEF_MAX_SIMULATED_TIME=1200
CHEF_TIMEOUT_SECONDS=300
