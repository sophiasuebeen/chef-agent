# Keep credentials in .env (ignored), or export them in the shell.
# Use your existing key; never paste it into source code.
# Required for the restaurant staff (OpenAI Agents SDK).
OPENAI_API_KEY=
# Staff model. Precedence: RESTAURANT_MODEL > CHEF_HOST_MODEL > CHEF_MODEL.
# Non-OpenAI model names fall back to gpt-4o.
RESTAURANT_MODEL=gpt-4o

# Optional: only for `evaluation.evolve --live` (Gemini via the Google GenAI SDK).
# GEMINI_API_KEY is also accepted; the Gemini Developer API is always selected.
GOOGLE_API_KEY=
