# Keep credentials in .env (ignored), or export them in the shell.
# Use your existing key; never paste it into source code.
GOOGLE_API_KEY=
# To use OpenAI: CHEF_MODEL=openai/gpt-4o.
OPENAI_API_KEY=
# GEMINI_API_KEY is also accepted. The host selects the Gemini Developer API.
# GOOGLE_GENAI_USE_VERTEXAI is set to false by the host configuration.
CHEF_MODEL=gemini-2.5-flash
# Optional: a different model for the customer-facing host. Defaults to CHEF_MODEL.
# CHEF_HOST_MODEL=openai/gpt-4o
# OpenAI SDK restaurant staff. Precedence: RESTAURANT_MODEL > CHEF_HOST_MODEL > CHEF_MODEL.
# Non-OpenAI legacy model settings fall back to gpt-4o for the staff team.
# RESTAURANT_MODEL=gpt-4o
